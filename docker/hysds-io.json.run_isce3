{
  "submission_type": "iteration",
  "params": [
    {
      "name": "runconfig_s3",
      "from": "submitter",
      "type": "text",
      "description": "inline runconfig YAML text (containing s3:// links), or a local path",
      "default": ""
    },
    {
      "name": "netrc_content",
      "from": "submitter",
      "type": "text",
      "description": "netrc credentials text (machine/login/password)",
      "default": ""
    },
    {
      "name": "output_dir",
      "from": "submitter",
      "type": "text",
      "description": "SAS product output directory",
      "default": "output"
    },
    {
      "name": "scratch_dir",
      "from": "submitter",
      "type": "text",
      "description": "SAS scratch directory",
      "default": "scratch"
    },
    {
      "name": "localized_runconfig",
      "from": "submitter",
      "type": "text",
      "description": "written localized runconfig",
      "default": "runconfig_localized.yaml"
    },
    {
      "name": "mozart_url",
      "from": "submitter",
      "type": "text",
      "description": "Mozart base URL used to mint DAAC S3 creds when the worker has no internet (auto-filled from otello config)",
      "default": ""
    },
    {
      "name": "mozart_auth",
      "from": "submitter",
      "type": "text",
      "description": "Mozart basic-auth 'username:password' for the DAAC cred endpoint (auto-filled from otello config)",
      "default": ""
    }
  ],
  "component": "tosca",
  "label": "ISCE3 PGE"
}