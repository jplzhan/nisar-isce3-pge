{
  "command": "notebook-pge-wrapper execute /home/jovyan/nisar-isce3-pge/notebook_pges/run_isce3.ipynb",
  "time_limit": 172800,
  "soft_time_limit": 172800,
  "disk_usage": "200GB",
  "runtime_options": {
    "gpus": "all"
  },
  "required_queues": [
    "factotum-job_worker-small"
  ],
  "imported_worker_files": {
    "$HOME/.aws": "/home/jovyan/.aws"
  },
  "params": [
    {
      "name": "runconfig_s3",
      "destination": "context"
    },
    {
      "name": "netrc_content",
      "destination": "context"
    },
    {
      "name": "output_dir",
      "destination": "context"
    },
    {
      "name": "scratch_dir",
      "destination": "context"
    },
    {
      "name": "localized_runconfig",
      "destination": "context"
    },
    {
      "name": "mozart_pvt_ip",
      "destination": "context"
    }
  ]
}
